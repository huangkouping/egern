#!name=航旅纵横去广告
#!desc=过滤航旅纵横广告
#!date=2024-07-26 21:19:28

[Rewrite]
^http?:\/\/(discardrp|startup)\.umetrip\.com\/gateway\/api\/umetrip\/native reject

[Script]
http-response ^http?:\/\/(114\.115\.217\.129)|(home\.umetrip\.com)\/gateway\/api\/umetrip\/native$ script-path=https://gitlab.com/lodepuly/vpn_tool/-/raw/master/Resource/Script/Umetrip/Umetrip_remove_ads.js, requires-body=true, timeout=60, tag=移除首页广告

[MITM]
hostname = 114.115.217.129, home.umetrip.com
